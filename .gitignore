# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp

# Claude Code local settings
.claude/settings.local.json

# --- impeccable-ignore-start ---
# Ephemeral impeccable output (keep config.json, design.json, surfaces/, critique/)
.impeccable/tmp/
.impeccable/cache/
.critique/
# --- impeccable-ignore-end ---

# Tooling state
*.log
coverage/
.playwright/

# Playwright visual-harness run artifacts (baselines under tests/visual/ stay tracked)
test-results/
playwright-report/

# playwright-cli runtime output (keep PRD evidence captures explicitly)
.playwright-cli/*
!.playwright-cli/tbank-home-full.png
!.playwright-cli/page-2026-09-21T19-07-00-623Z.yml
# per-story verification captures — the directory is whitelisted once, files land in it freely
!.playwright-cli/verify/

# OMC / Claude Code runtime state (skills, agents, settings.json stay tracked)
.omc/
.claude/state/
.claude/sessions/


# BMAD runtime render snapshots (regenerated per skill invocation)
_bmad/render/

# Local licensed fonts — never published (docs preview picks them up via import.meta.glob)
packages/docs/src/local-fonts/*
!packages/docs/src/local-fonts/README.md
!packages/docs/src/local-fonts/local-fonts.example.css
