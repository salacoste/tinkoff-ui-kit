{
  "name": "tinkoff-ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "UI kit based on the Tinkoff (T-Bank) design language — recreated, systematized and improved",
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:tokens": "pnpm --filter @tk-kit/tokens gen:tokens",
    "check:tokens-drift": "pnpm gen:tokens && git diff --exit-code -- packages/tokens && test -z \"$(git status --porcelain -- packages/tokens/src packages/tokens/scripts)\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@types/node": "26.6.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "happy-dom": "^20.14.5",
    "lit": "3.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
