{
  "name": "@tk-kit/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens for tinkoff-ui-kit — the extracted --tk-* custom property system. Light layer on :host/:root (dark layer on [data-theme=\"dark\"] lands in Story 1.3). Generated from DESIGN.md: pnpm gen:tokens.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/index.css",
    "./TOKENS.md": "./src/TOKENS.md"
  },
  "files": [
    "dist",
    "src/TOKENS.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "vitest run",
    "gen:tokens": "node scripts/generate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
