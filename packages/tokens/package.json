{
  "name": "pillkit-tokens",
  "version": "1.0.0",
  "description": "Design tokens for pillkit — the --tk-* custom-property system: light base layer + dark [data-theme=\"dark\"] semantic overrides, AA-verified pairs, optional bundled Daytona fonts (separately licensed).",
  "keywords": [
    "pillkit",
    "design-tokens",
    "design-system",
    "css-variables",
    "custom-properties",
    "theming",
    "dark-mode"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salacoste/tinkoff-ui-kit.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/index.css",
    "./daytona.css": "./fonts/daytona.css",
    "./TOKENS.md": "./src/TOKENS.md"
  },
  "files": [
    "dist",
    "fonts",
    "src/TOKENS.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "vitest run",
    "gen:tokens": "node scripts/generate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "private": true
}
