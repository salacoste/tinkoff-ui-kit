{
  "name": "pillkit-react",
  "version": "1.0.0",
  "description": "React 19 adapters for pillkit — wrappers generated from the Custom Elements Manifest of pillkit-components via @lit/react; event handlers receive unwrapped detail payloads.",
  "keywords": [
    "pillkit",
    "react",
    "react-components",
    "web-components",
    "custom-elements",
    "lit",
    "wrappers",
    "ui-kit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salacoste/tinkoff-ui-kit.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "vitest run",
    "gen:wrappers": "node scripts/generate-wrappers.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lit/react": "1.0.8",
    "pillkit-components": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react-dom": "19.3.0"
  },
  "private": true
}
