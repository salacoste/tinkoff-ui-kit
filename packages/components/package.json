{
  "name": "@tk-kit/components",
  "version": "0.0.0",
  "private": true,
  "description": "Lit custom elements core package for tinkoff-ui-kit — the single source of component behavior, rendered via Shadow DOM and themed with --tk-* custom properties.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./CONVENTIONS.md": "./CONVENTIONS.md",
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "CONVENTIONS.md",
    "custom-elements.json"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "vitest run",
    "gen:manifest": "cem analyze --config cem.config.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "customElements": "custom-elements.json",
  "devDependencies": {
    "@storybook/web-components-vite": "10.6.0"
  }
}
