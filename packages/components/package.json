{
  "name": "pillkit-components",
  "version": "1.1.0",
  "description": "Lit custom elements core for pillkit — 19 tk-* components (forms, navigation, cards, overlays) rendered via Shadow DOM and themed with --tk-* custom properties; includes the shared overlay controller.",
  "keywords": [
    "pillkit",
    "web-components",
    "custom-elements",
    "lit",
    "ui-components",
    "ui-kit",
    "design-system",
    "forms",
    "overlays"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salacoste/tinkoff-ui-kit.git",
    "directory": "packages/components"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./CONVENTIONS.md": "./CONVENTIONS.md",
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "!dist/api-reference*",
    "CONVENTIONS.md",
    "custom-elements.json"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "vitest run",
    "gen:manifest": "cem analyze --config cem.config.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "customElements": "custom-elements.json",
  "devDependencies": {
    "@storybook/web-components-vite": "10.6.0"
  },
  "private": true
}
