{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true
  },
  "include": [
    "tests/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "packages/*/vite.config.ts"
  ],
  "exclude": [
    "packages/*/src",
    "packages/*/dist"
  ]
}
